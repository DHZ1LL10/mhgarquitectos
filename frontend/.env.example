# Local values are shown below. Staging must use its canonical HTTPS frontend/API
# domains; production remains a separate future environment.
# Set the URL of the separate test site before its build.
# For local inspection, use http://localhost:3000.
SITE_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# Server-only public catalog source. API is authoritative in local/staging/production.
# Set local only for isolated fixture tests that intentionally run without FastAPI.
PROPERTY_REPOSITORY=api
# Includes the API version prefix. This is server-only and contains no credentials.
PROPERTY_API_BASE_URL=http://localhost:8000/api/v1

# Browser API URL for real admin; no credentials.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Server-rendered runtime configuration for the independent legacy customizer.
CUSTOMIZER_API_BASE_URL=http://localhost:8000/api/v1
