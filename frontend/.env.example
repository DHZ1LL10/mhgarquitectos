# Set the URL of the separate test site before its build.
# For local inspection, use http://localhost:3000.
SITE_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# Server-only repository selection. Local remains the default; no API needed.
PROPERTY_REPOSITORY=local
# Used only when PROPERTY_REPOSITORY=api. Includes the API version prefix.
PROPERTY_API_BASE_URL=http://localhost:8000/api/v1
