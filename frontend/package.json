{
  "name": "mhg-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "npm run verify:legacy && next dev",
    "build": "npm run verify:legacy && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "sync:legacy": "node scripts/sync-legacy-assets.mjs",
    "verify:legacy": "node scripts/verify-legacy-assets.mjs",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.3"
  }
}
