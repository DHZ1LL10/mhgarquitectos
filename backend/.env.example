# Local examples only. Replace the example password in your untracked .env.
ENVIRONMENT=local
# Staging may set DATABASE_URL instead of DB_*; never commit its value.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mhg
DB_USER=mhg
DB_PASSWORD=local-development-only
DB_SSLMODE=disable
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
POSTGRES_PORT=5432
API_PORT=8000
# Staging/production require Secure. This architecture permits only lax or strict.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_NAME=mhg_session
SESSION_HOURS=8
CORS_ORIGINS=["http://localhost:3000"]
OPENAPI_ENABLED=true
MAX_REQUEST_BODY_BYTES=1048576
# Forwarded headers are ignored unless the immediate peer is in this exact CIDR list.
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=[]
PUBLIC_RATE_LIMIT_ENABLED=true
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=900
PUBLIC_RATE_LIMIT_KITCHEN_SUBMISSIONS=10
PUBLIC_RATE_LIMIT_LEADS=20
PUBLIC_RATE_LIMIT_APPOINTMENTS=10
PUBLIC_RATE_LIMIT_KITCHEN_CONFIGURATIONS=10
LOG_LEVEL=INFO

# Optional locally. Configure all delivery fields in staging/production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
NOTIFICATION_EMAIL=
# Valid only with ENVIRONMENT=staging; staging SMTP requires it.
STAGING_EMAIL_OVERRIDE=

