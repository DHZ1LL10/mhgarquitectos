# Local examples only. Replace the example password in your untracked .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mhg
DB_USER=mhg
DB_PASSWORD=local-development-only
POSTGRES_PORT=5432
API_PORT=8000
# Use true with HTTPS. SameSite=none requires Secure for cross-site hosting.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_HOURS=8
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Optional locally. Configure all delivery fields in staging/production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
NOTIFICATION_EMAIL=

